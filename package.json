{
  "name": "dsh-workspace-dir",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: show the current conversation's working directory in a draggable directory panel with adjustable opacity.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "file-explorer"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  }
}
